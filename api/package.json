{
  "name": "@tarati/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "engine:sync": "node scripts/sync-engine.mjs",
    "prebuild": "node scripts/sync-engine.mjs",
    "dev": "tsx watch src/dev-server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/dev-server.js",
    "test": "node scripts/sync-engine.mjs && node --test test/engine-parity.test.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "test:integration": "node scripts/sync-engine.mjs && node --test --test-concurrency=1 \"test/integration/*.test.js\""
  },
  "dependencies": {
    "@hono/node-server": "^1.14.1",
    "@hono/zod-validator": "^0.7.6",
    "better-auth": "^1.4.19",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.9.8",
    "pg": "^8.16.3",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@types/node": "^24.3.1",
    "@types/pg": "^8.16.0",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
