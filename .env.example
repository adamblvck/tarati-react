# =============================================================================
# Tarati env — copy to .env.dev (local) and .env.prod (deploy). Never commit.
# =============================================================================

# --- Frontend (Create React App) -------------------------------------------
# Empty in local dev (the CRA dev server proxies /api -> localhost:8787).
# Leave EMPTY in both dev and prod: locally CRA's "proxy" forwards /api to
# :8787, and in production netlify.toml rewrites /api/* to the Scaleway
# function. Same-origin either way, so session cookies just work.
REACT_APP_API_BASE_URL=

# Show the "Continue with Google" button. Only set true when the API actually
# has GOOGLE_CLIENT_ID/SECRET, or the button renders and does nothing.
REACT_APP_GOOGLE_ENABLED=false

# --- API runtime -----------------------------------------------------------
NODE_ENV=development
API_PORT=8787

# Per-turn forfeit window (seconds). A player who doesn't move in time forfeits.
# 60 is brutal at an event — people talk between moves. 600 (10 min) is sane.
TURN_TIMEOUT_SECONDS=600

# Unauthenticated read-only game views at /watch, for a projector at an event.
# Exposes game names, player display names and board positions to anyone.
SPECTATOR_MODE=true

# node-postgres pool size PER function instance. The managed Postgres is shared
# with other apps, so keep this small: max_scale x PGPOOL_MAX is the ceiling.
PGPOOL_MAX=3

# --- Database --------------------------------------------------------------
# Local (through the SSH tunnel). Password = the one you set in sql/00_*.sql.
DATABASE_URL_DEV=postgresql://tarati_api_dev:CHANGE_ME@localhost:15432/tarati_dev
# Production (set the real value as a SECRET in the Scaleway console, not here).
DATABASE_URL_PRD=postgresql://tarati_api_prd:CHANGE_ME@DB_HOST:5432/tarati_prd

# --- Better Auth -----------------------------------------------------------
# 32+ char random string: `openssl rand -base64 32`
BETTER_AUTH_SECRET=CHANGE_ME_min_32_chars_long_secret_value
# Dev: http://localhost:8787   Prod: https://api.tarati.blvckstudios.com
BETTER_AUTH_BASE_URL=http://localhost:8787
# Dev: http://localhost:3000   Prod: https://tarati.blvckstudios.com
BETTER_AUTH_TRUSTED_ORIGIN=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
# Frontend origin (used to build email links / post-verification redirects).
APP_BASE_URL=http://localhost:3000

# --- Google OAuth (optional; social login enabled only when both are set) ---
# Redirect URI: <BETTER_AUTH_BASE_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Scaleway Transactional Email (password reset + verification) ----------
# X-Auth-Token = a Scaleway API secret key. TEM lives in fr-par.
SCW_SECRET_KEY=
SCW_PROJECT_ID=
SCW_TEM_REGION=fr-par
TEM_FROM_EMAIL=no-reply@tarati.blvckstudios.com
TEM_FROM_NAME=Tarati

# --- Forfeit cron backstop -------------------------------------------------
# Shared secret required in the x-cron-secret header on the sweep endpoint.
CRON_SWEEP_SECRET=

# --- SSH bastion tunnel (local dev only) -----------------------------------
BASTION_USERNAME=
BASTION_HOST=
# Defaults to ~/.ssh/Scaleway_BLVCKSTUDIOS_DB_Bastion if unset.
BASTION_KEY_PATH=
PGHOST=
PGPORT=5432
# Optional: if set (and DATABASE_URL unset), dev/db scripts derive the DB URL.
PGUSER=tarati_api_dev
PGPASSWORD=CHANGE_ME
# Not 5432: start-db-tunnel.sh reuses whatever already holds the port, so a
# local Postgres would silently receive your migrations.
LOCAL_DB_TUNNEL_PORT=15432
LOCAL_DB_NAME=tarati_dev

# --- Scaleway deploy overrides (optional; defaults shown) -------------------
# SCW_REGION=nl-ams
# SCW_FUNCTION_NAMESPACE=tarati-cloud-functions
# SCW_FUNCTION_NAME=tarati-api-prd
# SCW_FUNCTION_RUNTIME=node22        (node20 is end-of-support on Scaleway)
# Required by scw-init.sh: the managed Postgres has no public endpoint, so a
# function without this attachment cannot reach the database at all.
# SCW_PRIVATE_NETWORK_ID=bd22f7c8-ef61-4cf9-87a1-c94c2cc61276
